# Python 缓存与测试产物
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

# 本地环境、密钥和编辑器设置
.venv/
venv/
env/
.env
.env.*
!.env.example
/.streamlit/*
!/.streamlit/config.toml
!/.streamlit/secrets.toml.example
.vscode/
.idea/
.codex/
.agents/

# 原始数据与下载压缩包；保留数据来源说明
data/**/*.csv
data/**/*.parquet
data/**/*.xlsx
data/**/*.zip
data/**/*.7z

# 只提交看板必需的三份报告，排除实验备份和验收截图
/reports/*
!/reports/.gitkeep
!/reports/latest.json
!/reports/test_scores.csv
!/reports/hour_profile.csv

